# Copy this file to .env.local and fill in your own values.

# Contact form email delivery (see components/ContactForm.js for setup steps):
# 1. Sign up free at https://formspree.io
# 2. Create a form, point it at the inbox you want submissions delivered to
# 3. Paste the endpoint it gives you below
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID
